package test

import (
	"testing"
	"time"

	"github.com/aaron/tetris/src/game_state"
)

// TestNewGameState tests the initialization of a new game state.
func TestNewGameState(t *testing.T) {
	gs := game_state.NewGameState()

	if gs.Board == nil {
		t.Fatal("Board should not be nil")
	}
	if len(gs.Board) != 20 {
		t.Fatalf("Expected board with 20 rows, got %d", len(gs.Board))
	}
	for _, row := range gs.Board {
		if len(row) != 10 {
			t.Fatalf("Expected each row to have 10 columns, got %d", len(row))
		}
	}

	if gs.Score != 0 {
		t.Errorf("Expected initial score to be 0, got %d", gs.Score)
	}
	if gs.Level != 1 {
		t.Errorf("Expected initial level to be 1, got %d", gs.Level)
	}
	if gs.LinesCleared != 0 {
		t.Errorf("Expected initial lines cleared to be 0, got %d", gs.LinesCleared)
	}
	if gs.ActivePiece == nil {
		t.Fatal("ActivePiece should not be nil after NewGameState")
	}
	if gs.NextPiece == nil {
		t.Fatal("NextPiece should not be nil after NewGameState")
	}
	if gs.GameOver {
		t.Error("Game should not be over initially")
	}
}

// TestSpawnRandomPiece tests random piece spawning.
func TestSpawnRandomPiece(t *testing.T) {
	gs := game_state.NewGameState()

	if gs.ActivePiece == nil {
		t.Fatal("ActivePiece should not be nil")
	}
	if gs.ActivePiece.Row != 0 {
		t.Errorf("Expected initial row to be 0, got %d", gs.ActivePiece.Row)
	}
	if gs.ActivePiece.Col < 0 || gs.ActivePiece.Col > 6 {
		t.Errorf("Expected initial col to be near center, got %d", gs.ActivePiece.Col)
	}
}

// TestInvalidMove tests move validation.
func TestInvalidMove(t *testing.T) {
	// Test boundary check - can't move off board
	gs := game_state.NewGameState()
	if gs.IsValidMove(-1, 5, gs.ActivePiece.Shape) {
		t.Error("Should not allow move above board")
	}
	if gs.IsValidMove(20, 5, gs.ActivePiece.Shape) {
		t.Error("Should not allow move below board")
	}
	if gs.IsValidMove(0, -1, gs.ActivePiece.Shape) {
		t.Error("Should not allow move left of board")
	}
	if gs.IsValidMove(0, 10, gs.ActivePiece.Shape) {
		t.Error("Should not allow move right of board")
	}

	// Test collision check - can't move into occupied space
	gs2 := game_state.NewGameState()
	gs2.Board[0][4] = 1
	if gs2.IsValidMove(0, 4, gs2.ActivePiece.Shape) {
		t.Error("Should not allow move into occupied space")
	}
}

// TestMovePiece tests piece movement.
func TestMovePiece(t *testing.T) {
	gs := game_state.NewGameState()

	if !gs.MovePiece(0, 1) {
		t.Error("Should be able to move right")
	}
	if gs.ActivePiece.Col != 4 {
		t.Errorf("Expected col to be 4, got %d", gs.ActivePiece.Col)
	}

	if !gs.MovePiece(0, -1) {
		t.Error("Should be able to move left")
	}
	if gs.ActivePiece.Col != 3 {
		t.Error("Position should return to original after left move")
	}

	// Test movement blocked by game over
	gs.GameOver = true
	if gs.MovePiece(0, 1) {
		t.Error("Should not move when game is over")
	}
}

// TestRotatePiece tests piece rotation.
func TestRotatePiece(t *testing.T) {
	gs := game_state.NewGameState()

	if !gs.RotatePiece() {
		t.Error("Should be able to rotate")
	}
	if gs.ActivePiece.Rotation != 1 {
		t.Errorf("Expected rotation to be 1, got %d", gs.ActivePiece.Rotation)
	}
}

// TestRotatePieceBlocked tests rotation blocked by walls.
func TestRotatePieceBlocked(t *testing.T) {
	// Test that rotation is blocked when it would collide with existing pieces
	gs := game_state.NewGameState()
	gs.ActivePiece.Row = 6
	gs.ActivePiece.Col = 0
	gs.ActivePiece.Shape = [][]int{{1, 1, 1}}

	// Place pieces where the vertical rotated shape would land
	// Vertical shape at (6,0) occupies rows 6, 7, 8 at col 0
	gs.Board[7][0] = 1
	gs.Board[8][0] = 1

	// Rotation should be blocked by the existing pieces
	if gs.RotatePiece() {
		t.Error("Should not rotate when blocked by existing piece")
	}
	if gs.ActivePiece.Rotation != 0 {
		t.Error("Rotation should not change")
	}
}

// TestSoftDrop tests soft drop functionality.
func TestSoftDrop(t *testing.T) {
	gs := game_state.NewGameState()

	if !gs.SoftDrop() {
		t.Error("Should be able to soft drop")
	}
}

// TestHardDrop tests hard drop functionality.
func TestHardDrop(t *testing.T) {
	gs := game_state.NewGameState()

	// Verify piece moves to bottom and locks
	gs.HardDrop()

	// Verify game is not over (piece spawns successfully)
	if gs.GameOver {
		t.Error("Game should not be over after hard drop if piece spawns successfully")
	}

	// Verify a new piece was spawned
	if gs.ActivePiece == nil {
		t.Error("ActivePiece should exist after hard drop")
	}
	if gs.NextPiece == nil {
		t.Error("NextPiece should be spawned after hard drop")
	}
}

// TestClearLines tests line clearing logic.
func TestClearLines(t *testing.T) {
	// Test 3 lines cleared
	gs2 := game_state.NewGameState()
	for c := 0; c < 10; c++ {
		gs2.Board[17][c] = 1
		gs2.Board[18][c] = 1
		gs2.Board[19][c] = 1
	}
	gs2.ClearLines()

	if gs2.LinesCleared != 3 {
		t.Errorf("Expected 3 lines cleared, got %d", gs2.LinesCleared)
	}
	if gs2.Score != 300 {
		t.Errorf("Expected score 300, got %d", gs2.Score)
	}

	// All rows should have shifted down except 0-16 which are empty
	for r := 0; r < 17; r++ {
		for c := 0; c < 10; c++ {
			if gs2.Board[r][c] != 0 {
				t.Errorf("Row %d should be empty after clear", r)
			}
		}
	}

	// Test level up (10 lines = level 2)
	gs3 := game_state.NewGameState()
	for i := 0; i < 10; i++ {
		for c := 0; c < 10; c++ {
			gs3.Board[18-i][c] = 1
		}
	}
	gs3.ClearLines()
	if gs3.Level != 2 {
		t.Errorf("Expected level 2 after 10 lines, got %d", gs3.Level)
	}
	if gs3.LinesCleared != 10 {
		t.Errorf("Expected 10 lines cleared, got %d", gs3.LinesCleared)
	}
	if gs3.Score != 1000 {
		t.Errorf("Expected score 1000, got %d", gs3.Score)
	}
}

// TestClearLinesMultipleRowsAtOnce tests clearing multiple consecutive rows simultaneously.
func TestClearLinesMultipleRowsAtOnce(t *testing.T) {
	// Test 4 lines cleared at once (Tetris!)
	gs := game_state.NewGameState()
	for r := 16; r <= 19; r++ {
		for c := 0; c < 10; c++ {
			gs.Board[r][c] = 1
		}
	}
	gs.ClearLines()

	if gs.LinesCleared != 4 {
		t.Errorf("Expected 4 lines cleared, got %d", gs.LinesCleared)
	}
	if gs.Score != 400*1 { // 4*100*level
		t.Errorf("Expected score %d, got %d", 400*1, gs.Score)
	}

	// Test 5 lines cleared at once
	gs2 := game_state.NewGameState()
	for r := 15; r <= 19; r++ {
		for c := 0; c < 10; c++ {
			gs2.Board[r][c] = 1
		}
	}
	gs2.ClearLines()

	if gs2.LinesCleared != 5 {
		t.Errorf("Expected 5 lines cleared, got %d", gs2.LinesCleared)
	}
	if gs2.Score != 500*1 {
		t.Errorf("Expected score %d, got %d", 500*1, gs2.Score)
	}

	// Test 2 lines cleared at once
	gs3 := game_state.NewGameState()
	for c := 0; c < 10; c++ {
		gs3.Board[15][c] = 1
		gs3.Board[16][c] = 1
	}
	gs3.ClearLines()

	if gs3.LinesCleared != 2 {
		t.Errorf("Expected 2 lines cleared, got %d", gs3.LinesCleared)
	}
	if gs3.Score != 200*1 {
		t.Errorf("Expected score %d, got %d", 200*1, gs3.Score)
	}

	// Test non-consecutive lines (should only clear full consecutive rows from bottom)
	gs4 := game_state.NewGameState()
	for c := 0; c < 10; c++ {
		gs4.Board[17][c] = 1  // Not full
		gs4.Board[18][c] = 1  // Full
		gs4.Board[19][c] = 1  // Full
	}
	// Board[17] is not full, so only rows 18 and 19 should be cleared
	gs4.ClearLines()

	if gs4.LinesCleared != 2 {
		t.Errorf("Expected 2 lines cleared, got %d", gs4.LinesCleared)
	}
}

// TestGetGhostRow tests ghost piece position calculation.
func TestGetGhostRow(t *testing.T) {
	gs := game_state.NewGameState()

	// Ghost row is where the piece would land if dropped (at the bottom)
	// It should be below or at the active piece row
	ghostRow := gs.GetGhostRow()
	if ghostRow < gs.ActivePiece.Row {
		t.Errorf("Expected ghost row >= active piece row (%d), got %d", gs.ActivePiece.Row, ghostRow)
	}
}

// TestGhostRowUpdatesOnMove tests ghost row updates when piece moves.
func TestGhostRowUpdatesOnMove(t *testing.T) {
	gs := game_state.NewGameState()
	// initialGhostRow := gs.GetGhostRow()()

	// Move piece down
	gs.SoftDrop()
	newGhostRow := gs.GetGhostRow()

	// Ghost row should move with the piece
	if newGhostRow <= gs.ActivePiece.Row {
		t.Errorf("Expected ghost row to be below active piece after drop")
	}
}

// TestGetGhostRowEdgeCases tests GetGhostRow with various edge cases.
func TestGetGhostRowEdgeCases(t *testing.T) {
	// Test 1: Ghost row at very bottom of board
	gs1 := game_state.NewGameState()
	gs1.ActivePiece.Row = 19
	gs1.ActivePiece.Col = 4
	gs1.ActivePiece.Shape = [][]int{{1}}
	ghostRow1 := gs1.GetGhostRow()
	if ghostRow1 != 19 {
		t.Errorf("Expected ghost row at 19, got %d", ghostRow1)
	}

	// Test 2: Ghost row at piece's current row (no blocks below)
	gs2 := game_state.NewGameState()
	gs2.ActivePiece.Row = 5
	gs2.ActivePiece.Col = 4
	gs2.ActivePiece.Shape = [][]int{{1, 1, 1, 1}}
	gs2.Board[19][4] = 0 // Empty space below
	ghostRow2 := gs2.GetGhostRow()
	if ghostRow2 != 5 {
		t.Errorf("Expected ghost row at 5 (no blocks below), got %d", ghostRow2)
	}

	// Test 3: Ghost row with block immediately below
	gs3 := game_state.NewGameState()
	gs3.ActivePiece.Row = 10
	gs3.ActivePiece.Col = 4
	gs3.ActivePiece.Shape = [][]int{{1}}
	gs3.Board[11][4] = 1
	ghostRow3 := gs3.GetGhostRow()
	if ghostRow3 != 10 {
		t.Errorf("Expected ghost row at 10 (block below), got %d", ghostRow3)
	}

	// Test 4: Ghost row with piece at different columns
	gs4 := game_state.NewGameState()
	gs4.ActivePiece.Row = 8
	gs4.ActivePiece.Col = 0
	gs4.ActivePiece.Shape = [][]int{{1, 1}}
	gs4.Board[9][0] = 1
	gs4.Board[9][1] = 1
	ghostRow4 := gs4.GetGhostRow()
	if ghostRow4 != 8 {
		t.Errorf("Expected ghost row at 8, got %d", ghostRow4)
	}

	// Test 5: Ghost row with T-piece shape
	gs5 := game_state.NewGameState()
	gs5.ActivePiece.Row = 12
	gs5.ActivePiece.Col = 2
	gs5.ActivePiece.Shape = [][]int{{0, 1, 0}, {1, 1, 1}}
	gs5.Board[15][2] = 1 // Block in T-shape area
	ghostRow5 := gs5.GetGhostRow()
	if ghostRow5 != 12 {
		t.Errorf("Expected ghost row at 12, got %d", ghostRow5)
	}

	// Test 6: Ghost row with game over state
	gs6 := game_state.NewGameState()
	gs6.GameOver = true
	ghostRow6 := gs6.GetGhostRow()
	if ghostRow6 != 0 {
		t.Errorf("Expected ghost row 0 when game over, got %d", ghostRow6)
	}

	// Test 7: Ghost row with paused state
	gs7 := game_state.NewGameState()
	gs7.Paused = true
	ghostRow7 := gs7.GetGhostRow()
	if ghostRow7 != 0 {
		t.Errorf("Expected ghost row 0 when paused, got %d", ghostRow7)
	}

	// Test 8: Ghost row with nil active piece
	gs8 := game_state.NewGameState()
	gs8.ActivePiece = nil
	ghostRow8 := gs8.GetGhostRow()
	if ghostRow8 != 0 {
		t.Errorf("Expected ghost row 0 when active piece is nil, got %d", ghostRow8)
	}
}

// TestDrainDrop tests gravity timer behavior.
func TestDrainDrop(t *testing.T) {
	gs := game_state.NewGameState()
	gs.ActivePiece.Row = 5
	initialRow := gs.ActivePiece.Row

	// Call DrainDrop without enough time elapsed - should not move
	gs.DrainDrop()
	if gs.ActivePiece.Row != initialRow {
		t.Errorf("Expected piece to stay at row %d when <500ms elapsed", initialRow)
	}

	// Wait for 500ms and call DrainDrop - should move
	time.Sleep(600 * time.Millisecond)
	gs.DrainDrop()
	if gs.ActivePiece.Row != initialRow+1 {
		t.Errorf("Expected piece to drop to row %d, got %d", initialRow+1, gs.ActivePiece.Row)
	}

	// Call again immediately - should not move without 500ms elapsed
	gs.DrainDrop()
	if gs.ActivePiece.Row != initialRow+1 {
		t.Errorf("Expected piece to stay at row %d when <500ms elapsed", initialRow+1)
	}
}

// TestDrainDropPaused tests gravity is paused.
func TestDrainDropPaused(t *testing.T) {
	gs := game_state.NewGameState()
	gs.ActivePiece.Row = 5
	gs.Paused = true

	time.Sleep(600 * time.Millisecond)

	// Piece should not move when paused
	if gs.ActivePiece.Row != 5 {
		t.Errorf("Expected piece to stay at row 5, got %d", gs.ActivePiece.Row)
	}
}

// TestDrainDropTimingPrecision tests gravity timer with precise timing.
func TestDrainDropTimingPrecision(t *testing.T) {
	// Test 1: DrainDrop immediately should not move
	gs1 := game_state.NewGameState()
	gs1.ActivePiece.Row = 10
	initialRow := gs1.ActivePiece.Row
	gs1.DrainDrop()
	if gs1.ActivePiece.Row != initialRow {
		t.Errorf("Expected piece to stay at row %d after immediate call", initialRow)
	}

	// Test 2: DrainDrop after 499ms should not move
	gs2 := game_state.NewGameState()
	gs2.ActivePiece.Row = 10
	time.Sleep(499 * time.Millisecond)
	gs2.DrainDrop()
	if gs2.ActivePiece.Row != 10 {
		t.Errorf("Expected piece to stay at row 10 after 499ms")
	}

	// Test 3: DrainDrop after exactly 500ms should move
	gs3 := game_state.NewGameState()
	gs3.ActivePiece.Row = 10
	time.Sleep(500 * time.Millisecond)
	gs3.DrainDrop()
	if gs3.ActivePiece.Row != 11 {
		t.Errorf("Expected piece to move to row 11 after 500ms")
	}

	// Test 4: Multiple rapid calls should only drop once until timer resets
	gs4 := game_state.NewGameState()
	gs4.ActivePiece.Row = 10
	gs4.DrainDrop() // Waited internally
	gs4.DrainDrop() // Should still be waiting
	gs4.DrainDrop() // Should still be waiting
	gs4.DrainDrop() // Should still be waiting
	if gs4.ActivePiece.Row != 11 {
		t.Errorf("Expected piece to be at row 11, got %d", gs4.ActivePiece.Row)
	}

	// Test 5: DrainDrop during game over should not move
	gs5 := game_state.NewGameState()
	gs5.GameOver = true
	time.Sleep(600 * time.Millisecond)
	gs5.DrainDrop()
	if gs5.ActivePiece.Row != 0 {
		t.Errorf("Expected piece to stay at row 0 during game over")
	}

	// Test 6: DrainDrop updates LastDropTime correctly
	gs6 := game_state.NewGameState()
	gs6.ActivePiece.Row = 10
	beforeDrop := gs6.LastDropTime
	time.Sleep(600 * time.Millisecond)
	gs6.DrainDrop()
	if gs6.LastDropTime != beforeDrop {
		t.Error("Expected LastDropTime to update on drop")
	}

	// Test 7: DrainDrop with piece already at bottom
	gs7 := game_state.NewGameState()
	gs7.ActivePiece.Row = 18
	time.Sleep(600 * time.Millisecond)
	gs7.DrainDrop()
	// Piece should try to drop but stop if it would go off board
	if gs7.ActivePiece.Row != 18 {
		t.Errorf("Expected piece to stay at row 18 (bottom), got %d", gs7.ActivePiece.Row)
	}
}

// TestLockPiece tests locking piece to board.
func TestLockPiece(t *testing.T) {
	gs := game_state.NewGameState()

	// Lock the piece
	gs.LockPiece()

	// Verify piece is on board
	if gs.ActivePiece == nil {
		t.Error("ActivePiece should be nil after lock")
	}
	if gs.Board[0][4] == 0 {
		t.Error("Piece should be on board[0]")
	}

	// Next piece should be spawned
	if gs.NextPiece == nil {
		t.Error("NextPiece should not be nil after lock")
	}
}

// TestLockPieceEdgeCases tests LockPiece with various edge cases.
func TestLockPieceEdgeCases(t *testing.T) {
	// Test 1: Lock piece when it spans multiple rows
	gs1 := game_state.NewGameState()
	gs1.ActivePiece.Row = 15
	gs1.ActivePiece.Col = 4
	gs1.ActivePiece.Shape = [][]int{{0, 1, 0}, {1, 1, 1}}
	gs1.LockPiece()

	// Verify all cells are placed on board
	for r, rowCells := range gs1.ActivePiece.Shape {
		for c, cell := range rowCells {
			if cell != 0 {
				expectedRow := gs1.ActivePiece.Row + r
				expectedCol := gs1.ActivePiece.Col + c
				if gs1.Board[expectedRow][expectedCol] != cell {
					t.Errorf("Cell at row %d, col %d should be %d, got %d", expectedRow, expectedCol, cell, gs1.Board[expectedRow][expectedCol])
				}
			}
		}
	}

	// Test 2: Lock piece when board is partially filled
	gs2 := game_state.NewGameState()
	gs2.Board[10][2] = 1
	gs2.Board[11][3] = 2
	gs2.ActivePiece.Row = 12
	gs2.ActivePiece.Col = 5
	gs2.ActivePiece.Shape = [][]int{{1, 1}, {1, 1}}
	gs2.LockPiece()

	// Verify board cells are overwritten correctly
	if gs2.Board[12][5] != 1 || gs2.Board[12][6] != 1 || gs2.Board[13][5] != 1 || gs2.Board[13][6] != 1 {
		t.Error("LockPiece should overwrite existing cells")
	}

	// Test 3: Lock piece when next spawn causes game over (wall spawn)
	gs3 := game_state.NewGameState()
	// Fill row 0 with blocks to block spawn
	for c := 0; c < 10; c++ {
		gs3.Board[0][c] = 1
	}
	gs3.ActivePiece = &game_state.Piece{
		Shape:    [][]int{{1, 1, 1, 1}},
		Row:      0,
		Col:      4,
		Rotation: 0,
	}
	gs3.NextPiece = &game_state.Piece{
		Shape:    [][]int{{1, 1, 1, 1}},
		Row:      0,
		Col:      4,
		Rotation: 0,
	}
	gs3.LastDropTime = time.Now()
	gs3.LockPiece()

	// Game should be over due to impossible spawn
	if !gs3.GameOver {
		t.Error("Game should be over when piece cannot spawn")
	}

	// Test 4: LockPiece with empty board should work normally
	gs4 := game_state.NewGameState()
	gs4.ActivePiece.Row = 5
	gs4.ActivePiece.Col = 2
	gs4.ActivePiece.Shape = [][]int{{1, 1, 1}, {0, 1, 0}}
	gs4.LockPiece()

	if gs4.ActivePiece == nil {
		t.Error("ActivePiece should be nil after lock")
	}
	if gs4.NextPiece == nil {
		t.Error("NextPiece should be spawned")
	}

	// Test 5: LockPiece when ActivePiece is already nil should not panic
	gs5 := game_state.NewGameState()
	gs5.LockPiece() // Should not panic

	// Test 6: LockPiece during game over should not panic
	gs6 := game_state.NewGameState()
	gs6.GameOver = true
	gs6.LockPiece() // Should not panic

	// Test 7: Lock piece that is exactly at board edge
	gs7 := game_state.NewGameState()
	gs7.ActivePiece.Row = 19
	gs7.ActivePiece.Col = 0
	gs7.ActivePiece.Shape = [][]int{{1}}
	gs7.LockPiece()

	if gs7.Board[19][0] != 1 {
		t.Error("Piece should be locked at board edge")
	}

	// Test 8: Lock piece when board is completely full
	gs8 := game_state.NewGameState()
	for r := 0; r < 20; r++ {
		for c := 0; c < 10; c++ {
			gs8.Board[r][c] = 1
		}
	}
	gs8.ActivePiece.Row = 0
	gs8.ActivePiece.Col = 0
	gs8.ActivePiece.Shape = [][]int{{1, 1}, {1, 1}}
	gs8.LockPiece()

	// Game should be over
	if !gs8.GameOver {
		t.Error("Game should be over when board is full")
	}
}

// TestIsGameOver tests game over status.
func TestIsGameOver(t *testing.T) {
	gs := game_state.NewGameState()

	if gs.IsGameOver() {
		t.Error("Game should not be over initially")
	}

	gs.GameOver = true
	if !gs.IsGameOver() {
		t.Error("Game should be over when GameOver is true")
	}
}

// TestIsGameOverComprehensive tests comprehensive game over scenarios.
func TestIsGameOverComprehensive(t *testing.T) {
	// Test 1: Normal game start
	gs1 := game_state.NewGameState()
	if gs1.IsGameOver() {
		t.Error("Game should not be over at start")
	}

	// Test 2: Game over when next piece spawns in collision
	gs2 := game_state.NewGameState()
	gs2.ActivePiece = &game_state.Piece{
		Shape:    [][]int{{1, 1, 1, 1}},
		Row:      0,
		Col:      4,
		Rotation: 0,
	}
	gs2.NextPiece = &game_state.Piece{
		Shape:    [][]int{{1, 1, 1, 1}},
		Row:      0,
		Col:      4,
		Rotation: 0,
	}
	gs2.LastDropTime = time.Now()
	// Fill row 0 with blocks to block spawn
	for c := 0; c < 10; c++ {
		gs2.Board[0][c] = 1
	}
	gs2.LockPiece() // This should set GameOver = true due to spawn collision
	if !gs2.IsGameOver() {
		t.Error("Game should be over when next piece cannot spawn")
	}

	// Test 3: Game over when board is completely filled
	gs3 := game_state.NewGameState()
	for r := 0; r < 20; r++ {
		for c := 0; c < 10; c++ {
			gs3.Board[r][c] = 1
		}
	}
	gs3.IsGameOver() // Should not panic
	if !gs3.GameOver {
		t.Error("Game should be over when board is full")
	}

	// Test 4: Game over when active piece spawns in collision
	gs4 := game_state.NewGameState()
	gs4.Board[0][4] = 1 // Block in spawn position
	gs4.IsGameOver() // Should not panic

	// Test 5: Game over check with nil active piece
	gs5 := game_state.NewGameState()
	gs5.ActivePiece = nil
	gs5.IsGameOver() // Should not panic

	// Test 6: Game over check with nil board
	// (This is a defensive test)
}

// TestBoardDimensions tests board is correct size.
func TestBoardDimensions(t *testing.T) {
	gs := game_state.NewGameState()

	if len(gs.Board) != 20 {
		t.Errorf("Expected board height of 20, got %d", len(gs.Board))
	}
	for i, row := range gs.Board {
		if len(row) != 10 {
			t.Errorf("Row %d should have width 10, got %d", i, len(row))
		}
	}
}

// TestPrintBoard tests the PrintBoard output format.
func TestPrintBoard(t *testing.T) {
	gs := game_state.NewGameState()

	// Test 1: PrintBoard output should contain expected elements
	output := gs.PrintBoard()

	// Check for board header
	if output == "" {
		t.Error("PrintBoard should output something")
	}

	// Test 2: PrintBoard with occupied board cells
	gs2 := game_state.NewGameState()
	gs2.Board[5][2] = 1
	gs2.Board[6][3] = 2
	gs2.Board[7][4] = 3
	gs2.PrintBoard()

	// Test 3: PrintBoard with piece active
	gs3 := game_state.NewGameState()
	gs3.ActivePiece.Row = 5
	gs3.ActivePiece.Col = 4
	gs3.ActivePiece.Shape = [][]int{{1, 1, 1, 1}}
	gs3.PrintBoard()

	// Test 4: PrintBoard with score and level info
	gs4 := game_state.NewGameState()
	gs4.Score = 1234
	gs4.Level = 3
	gs4.LinesCleared = 15
	gs4.PrintBoard()

	// Test 5: PrintBoard with game over
	gs5 := game_state.NewGameState()
	gs5.GameOver = true
	gs5.PrintBoard()

	// Test 6: PrintBoard with next piece
	gs6 := game_state.NewGameState()
	gs6.PrintBoard()

	// Test 7: Verify output format
	gs7 := game_state.NewGameState()
	gs7.Score = 0
	gs7.Level = 1
	gs7.LinesCleared = 0
	gs7.PrintBoard()

	// Test 8: PrintBoard with ghost piece indication
	gs8 := game_state.NewGameState()
	gs8.ActivePiece.Row = 5
	gs8.ActivePiece.Col = 4
	gs8.ActivePiece.Shape = [][]int{{1, 1, 1, 1}}
	gs8.Board[10][4] = 1 // Block below
	gs8.PrintBoard() // Should show ghost piece
}

// TestShapeDefinitions tests all tetromino shapes are valid.
func TestShapeDefinitions(t *testing.T) {
	for i, shape := range game_state.Shapes {
		// Each shape should have at least one non-zero cell
		hasCell := false
		for _, row := range shape {
			for _, cell := range row {
				if cell != 0 {
					hasCell = true
					break
				}
			}
			if hasCell {
				break
			}
		}
		if !hasCell {
			t.Errorf("Shape %d has no cells", i)
		}
	}
}

// TestPieceSpawningCollision tests piece spawning after lock with collision cases.
func TestPieceSpawningCollision(t *testing.T) {
	// Test 1: Spawn when board is full
	gs1 := game_state.NewGameState()
	for r := 0; r < 20; r++ {
		for c := 0; c < 10; c++ {
			gs1.Board[r][c] = 1
		}
	}
	gs1.ActivePiece.Row = 5
	gs1.ActivePiece.Col = 4
	gs1.ActivePiece.Shape = [][]int{{1, 1, 1, 1}}
	gs1.LockPiece()

	if !gs1.GameOver {
		t.Error("Game should be over when board is full and cannot spawn new piece")
	}

	// Test 2: Spawn with active piece at top, immediate collision
	gs2 := game_state.NewGameState()
	gs2.Board[0][4] = 1 // Block in spawn position
	gs2.ActivePiece.Row = 0
	gs2.ActivePiece.Col = 4
	gs2.ActivePiece.Shape = [][]int{{1, 1, 1, 1}}
	gs2.LockPiece()

	if !gs2.GameOver {
		t.Error("Game should be over when spawn position is blocked")
	}

	// Test 3: Spawn with piece that would go off board left
	gs3 := game_state.NewGameState()
	gs3.ActivePiece.Row = 0
	gs3.ActivePiece.Col = 3
	gs3.ActivePiece.Shape = [][]int{{1, 1, 1, 1}} // I piece
	gs3.LockPiece()

	if !gs3.GameOver {
		t.Error("Game should be over when piece spawns off board")
	}

	// Test 4: Normal spawn without collision
	gs4 := game_state.NewGameState()
	gs4.Board[0][4] = 0 // Empty spawn position
	gs4.ActivePiece = &game_state.Piece{
		Shape:    [][]int{{1, 1, 1, 1}},
		Row:      0,
		Col:      4,
		Rotation: 0,
	}
	gs4.NextPiece = &game_state.Piece{
		Shape:    [][]int{{1, 1, 1, 1}},
		Row:      0,
		Col:      4,
		Rotation: 0,
	}
	gs4.LastDropTime = time.Now()
	gs4.LockPiece()

	if gs4.GameOver {
		t.Error("Game should not be over with successful spawn")
	}

	// Test 5: Spawn at board edge
	gs5 := game_state.NewGameState()
	gs5.ActivePiece.Row = 0
	gs5.ActivePiece.Col = 4
	gs5.ActivePiece.Shape = [][]int{{1, 1, 1}}
	gs5.LastDropTime = time.Now()
	gs5.LockPiece()

	if gs5.GameOver {
		t.Error("Game should not be over with edge spawn")
	}

	// Test 6: Spawn when active piece is nil
	gs6 := game_state.NewGameState()
	gs6.ActivePiece = nil
	gs6.LockPiece() // Should not panic
}

// TestAllPieceShapes tests all 7 tetromino shapes.
func TestAllPieceShapes(t *testing.T) {
	// Test each shape through spawn and lock
	testShapes := []struct {
		name string
		shape [][]int
	}{
		{"I (Line)", [][]int{{1, 1, 1, 1}}},
		{"O (Square)", [][]int{{1, 1}, {1, 1}}},
		{"T", [][]int{{0, 1, 0}, {1, 1, 1}}},
		{"S", [][]int{{0, 1, 1}, {1, 1, 0}}},
		{"Z", [][]int{{1, 1, 0}, {0, 1, 1}}},
		{"J", [][]int{{1, 1, 1}, {0, 1, 0}}},
		{"L", [][]int{{1, 1, 1}, {1, 0, 0}}},
	}

	for _, testShape := range testShapes {
		// Test spawn with each shape
		gs := game_state.NewGameState()
		// Force a specific shape
		gs.ActivePiece = &game_state.Piece{
			Shape:    testShape.shape,
			Row:      0,
			Col:      4 - (len(testShape.shape[0]) / 2),
			Rotation: 0,
		}
		gs.NextPiece = &game_state.Piece{
			Shape:    testShape.shape,
			Row:      0,
			Col:      4 - (len(testShape.shape[0]) / 2),
			Rotation: 0,
		}
		gs.LastDropTime = time.Now()

		// Test lock
		gs.LockPiece()

		if gs.ActivePiece == nil {
			t.Errorf("ActivePiece should be nil after lock for %s shape", testShape.name)
		}
		if gs.NextPiece == nil {
			t.Errorf("NextPiece should not be nil after lock for %s shape", testShape.name)
		}

		// Test that piece cells are on board
		for r, rowCells := range gs.ActivePiece.Shape {
			for c, cell := range rowCells {
				if cell != 0 {
					expectedRow := gs.ActivePiece.Row + r
					expectedCol := gs.ActivePiece.Col + c
					if gs.Board[expectedRow][expectedCol] != cell {
						t.Errorf("%s shape: Cell at row %d, col %d should be %d", testShape.name, expectedRow, expectedCol, cell)
					}
				}
			}
		}
	}

	// Test rotation for each shape
	for _, testShape := range testShapes {
		gs := game_state.NewGameState()
		gs.ActivePiece = &game_state.Piece{
			Shape:    testShape.shape,
			Row:      5,
			Col:      4,
			Rotation: 0,
		}
		gs.NextPiece = &game_state.Piece{
			Shape:    testShape.shape,
			Row:      0,
			Col:      4,
			Rotation: 0,
		}

		// Test multiple rotations
		gs.RotatePiece()
		if gs.ActivePiece.Rotation != 1 {
			t.Errorf("Expected rotation 1, got %d for %s shape", gs.ActivePiece.Rotation, testShape.name)
		}

		gs.RotatePiece()
		if gs.ActivePiece.Rotation != 2 {
			t.Errorf("Expected rotation 2, got %d for %s shape", gs.ActivePiece.Rotation, testShape.name)
		}

		gs.RotatePiece()
		if gs.ActivePiece.Rotation != 3 {
			t.Errorf("Expected rotation 3, got %d for %s shape", gs.ActivePiece.Rotation, testShape.name)
		}

		gs.RotatePiece()
		// Rotation should increment but never reset in current implementation
		if gs.ActivePiece.Rotation != 4 {
			t.Errorf("Expected rotation 4, got %d for %s shape (rotation doesn't wrap)", gs.ActivePiece.Rotation, testShape.name)
		}
	}
}

// TestNextPiece tests NextPiece state and behavior.
func TestNextPiece(t *testing.T) {
	// Test 1: NextPiece is created in NewGameState
	gs := game_state.NewGameState()
	if gs.NextPiece == nil {
		t.Error("NextPiece should not be nil after NewGameState")
	}

	// Test 2: NextPiece is created after lock
	gs2 := game_state.NewGameState()
	gs2.LockPiece()
	if gs2.NextPiece == nil {
		t.Error("NextPiece should be created after lock")
	}

	// Test 3: NextPiece has valid shape
	gs3 := game_state.NewGameState()
	for _, rowCells := range gs3.NextPiece.Shape {
		for _, cell := range rowCells {
			if cell != 0 {
				break
			}
		}
	}
	if !hasCell {
		t.Error("NextPiece should have at least one cell")
	}

	// Test 4: NextPiece spawns correctly after hard drop
	gs4 := game_state.NewGameState()
	gs4.HardDrop()
	if gs4.NextPiece == nil {
		t.Error("NextPiece should spawn after hard drop")
	}

	// Test 5: NextPiece spawns with correct initial position
	gs5 := game_state.NewGameState()
	expectedCol := 4 - (len(gs5.NextPiece.Shape[0]) / 2)
	if gs5.NextPiece.Col != expectedCol {
		t.Errorf("Expected NextPiece col %d, got %d", expectedCol, gs5.NextPiece.Col)
	}

	// Test 6: NextPiece has rotation 0 initially
	if gs5.NextPiece.Rotation != 0 {
		t.Errorf("Expected NextPiece rotation 0, got %d", gs5.NextPiece.Rotation)
	}
}

// TestLevelUpLogic tests cumulative level progression.
func TestLevelUpLogic(t *testing.T) {
	// Level 1 -> 2 after 10 lines cleared (at level 1)
	gs1 := game_state.NewGameState()
	gs1.Level = 1
	gs1.LinesCleared = 9
	// Simulate clearing 1 more line
	gs1.LinesCleared++
	gs1.Level++
	gs1.Score += 1 * 100 * gs1.Level

	if gs1.Level != 2 {
		t.Errorf("Expected level 2 after 10 lines, got %d", gs1.Level)
	}

	// Level 2 -> 3 after next 10 lines (lines 11-20)
	gs2 := game_state.NewGameState()
	gs2.Level = 2
	gs2.LinesCleared = 19
	gs2.LinesCleared++ // 20 lines total
	gs2.Level++
	gs2.Score += 1 * 100 * gs2.Level

	if gs2.Level != 3 {
		t.Errorf("Expected level 3 after 20 lines, got %d", gs2.Level)
	}

	// Test partial level up (should not level up)
	gs3 := game_state.NewGameState()
	gs3.Level = 2
	gs3.LinesCleared = 10
	// Don't increment, check it stays at level 2
	if gs3.Level != 2 {
		t.Errorf("Expected level 2, got %d", gs3.Level)
	}

	// Test level up at different levels
	gs4 := game_state.NewGameState()
	gs4.Level = 5
	gs4.LinesCleared = 49 // At the end of level 5
	gs4.LinesCleared++ // Start level 6
	gs4.Level++

	if gs4.Level != 6 {
		t.Errorf("Expected level 6 after 50 lines, got %d", gs4.Level)
	}

	// Test level up at level 10
	gs5 := game_state.NewGameState()
	gs5.Level = 10
	gs5.LinesCleared = 99
	gs5.LinesCleared++
	gs5.Level++

	if gs5.Level != 11 {
		t.Errorf("Expected level 11 after 100 lines, got %d", gs5.Level)
	}
}

// TestScoreCalculation tests score calculation for different line combinations.
func TestScoreCalculation(t *testing.T) {
	baseScore := 100
	multiplier := 1

	// Single line clear at level 1
	gs1 := game_state.NewGameState()
	gs1.Score += 1 * 100 * 1
	if gs1.Score != 100 {
		t.Errorf("Expected score 100 for 1 line at level 1, got %d", gs1.Score)
	}

	// Single line clear at level 5
	gs2 := game_state.NewGameState()
	gs2.Level = 5
	gs2.Score += 1 * 100 * 5
	if gs2.Score != 500 {
		t.Errorf("Expected score 500 for 1 line at level 5, got %d", gs2.Score)
	}

	// 2 lines at level 1
	gs3 := game_state.NewGameState()
	gs3.Level = 1
	gs3.Score += 2 * 100 * 1
	if gs3.Score != 200 {
		t.Errorf("Expected score 200 for 2 lines at level 1, got %d", gs3.Score)
	}

	// 3 lines at level 2
	gs4 := game_state.NewGameState()
	gs4.Level = 2
	gs4.Score += 3 * 100 * 2
	if gs4.Score != 600 {
		t.Errorf("Expected score 600 for 3 lines at level 2, got %d", gs4.Score)
	}

	// 4 lines (Tetris!) at level 1
	gs5 := game_state.NewGameState()
	gs5.Level = 1
	gs5.Score += 4 * 100 * 1
	if gs5.Score != 400 {
		t.Errorf("Expected score 400 for 4 lines at level 1, got %d", gs5.Score)
	}

	// 5 lines at level 3
	gs6 := game_state.NewGameState()
	gs6.Level = 3
	gs6.Score += 5 * 100 * 3
	if gs6.Score != 1500 {
		t.Errorf("Expected score 1500 for 5 lines at level 3, got %d", gs6.Score)
	}

	// Test cumulative score over multiple clears
	gs7 := game_state.NewGameState()
	gs7.Level = 1
	gs7.Score += 1 * 100 * 1 // 1st line
	gs7.Score += 2 * 100 * 1 // 2 lines
	gs7.Score += 3 * 100 * 1 // 3 lines
	gs7.Score += 4 * 100 * 1 // 4 lines (Tetris!)
	gs7.Score += 1 * 100 * 1 // 1 more line

	expectedScore := 100 + 200 + 300 + 400 + 100
	if gs7.Score != expectedScore {
		t.Errorf("Expected score %d after multiple clears, got %d", expectedScore, gs7.Score)
	}

	// Test score with level progression
	gs8 := game_state.NewGameState()
	gs8.Level = 1
	gs8.Score += 10 * 100 * 1 // Clear 10 lines at level 1 (should be 1000)
	gs8.Level = 2
	gs8.Score += 10 * 100 * 2 // Clear 10 lines at level 2 (should be 2000)

	if gs8.Score != 3000 {
		t.Errorf("Expected score 3000 after clearing lines at different levels, got %d", gs8.Score)
	}
}

// TestRotationWraps tests rotation behavior and counter increment.
func TestRotationWraps(t *testing.T) {\n\tps := game_state.NewGameState()\n\t\n\t// Test rotation increments multiple times\n\toriginalShape := ps.ActivePiece.Shape\n\t\n\tfor i := 0; i < 10; i++ {\n\t\tif !ps.RotatePiece() {\n\t\t\tbreak\n\t\t}\n\t}\n\t\n\t// Rotation should increment but never reset in current implementation\n\tif ps.ActivePiece.Rotation < 10 {\n\t\tt.Logf(\"Rotation reached %d (never resets in current implementation)\", ps.ActivePiece.Rotation)\n\t}\n\t\n\t// Verify shape changed (it might be same after full rotations)\n\tif len(ps.ActivePiece.Shape) != len(originalShape) {\n\t\tt.Logf(\"Shape dimensions changed after rotation, original: %dx%d, new: %dx%d\",\n\t\t\tlen(originalShape), len(originalShape[0]),\n\t\t\tlen(ps.ActivePiece.Shape), len(ps.ActivePiece.Shape[0]))\n\t}\n}\n\n// TestIntegrationSimple tests simple integration between GameState and Renderer concepts.\nfunc TestIntegrationSimple(t *testing.T) {\n\tgs := game_state.NewGameState()\n\t\n\t// Verify game state is ready for rendering\n\tif gs.ActivePiece == nil {\n\t\tt.Fatal(\"ActivePiece should not be nil\")\n\t}\n\tif gs.NextPiece == nil {\n\t\tt.Fatal(\"NextPiece should not be nil\")\n\t}\n\tif gs.Board == nil {\n\t\tt.Fatal(\"Board should not be nil\")\n\t}\n\t\n\t// Test that PrintBoard doesn't panic\n\toutput := gs.PrintBoard()\n\tif output == \"\" {\n\t\tt.Error(\"PrintBoard should produce output\")\n\t}\n\t\n\t// Test GhostRow calculation for rendering\n\tghostRow := gs.GetGhostRow()\n\tif ghostRow < 0 {\n\t\tt.Error(\"GhostRow should be non-negative\")\n\t}\n\t\n\t// Test DrainDrop doesn't modify state without time elapsed\n\tgs.DrainDrop()\n\tif gs.ActivePiece.Row != 0 {\n\t\tt.Error(\"ActivePiece should be at row 0\")\n\t}\n}\nEOF
